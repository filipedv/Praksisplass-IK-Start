# Copy this file to .env (git-ignored) and fill in your values.
# VITE_* variables are bundled into the web page, so anyone who can open the
# admin panel can read them. That's fine for these two: the publishable key is
# designed to be public, and Row Level Security protects the data. NEVER put the
# secret key here.

# Supabase Dashboard → Project Settings → API Keys (same project as the player app).
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
