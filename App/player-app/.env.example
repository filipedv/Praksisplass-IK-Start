# Copy this file to .env (git-ignored) and fill in your values.
# EXPO_PUBLIC_* variables are bundled INTO the app, so anyone with the app can
# read them. That's fine for these two: the publishable key is designed to be
# public, and Row Level Security protects the data. NEVER put a secret key here.

# Supabase Dashboard → Project Settings → API Keys (EU-region project).
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Which food recognizer to use: "mock" (default, free, no network),
# "fatsecret" (needs the recognition-proxy running), or "vision" (not built yet).
EXPO_PUBLIC_RECOGNIZER=mock

# Only used when EXPO_PUBLIC_RECOGNIZER=fatsecret. Your Mac's LAN address and
# the proxy's port, e.g. http://192.168.1.23:8787 (phone and Mac on same Wi-Fi).
EXPO_PUBLIC_RECOGNITION_PROXY_URL=http://192.168.1.23:8787
