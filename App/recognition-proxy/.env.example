# Copy to .env (git-ignored). NEVER commit .env.

# From the FatSecret Platform dashboard (Premier Free, Image Recognition enabled).
# Remember to add this machine's PUBLIC IP to the IP allow-list there.
FATSECRET_CLIENT_ID=
FATSECRET_CLIENT_SECRET=
# The public IPv4 addresses you've whitelisted in the FatSecret dashboard,
# comma-separated. Only used to WARN you at startup if you're on a network
# that isn't whitelisted. (Find yours with: curl -4 ifconfig.me)
FATSECRET_ALLOWED_IPS=
# Optional, Premier feature: results for a country/language, e.g. NO / nb.
# Leave empty to use FatSecret's default (US).
FATSECRET_REGION=
FATSECRET_LANGUAGE=

# Same Supabase project as the apps — used ONLY to check that callers are
# logged-in, active users. The publishable key is enough for that.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

PORT=8787
